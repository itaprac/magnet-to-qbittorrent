{
  "manifest_version": 2,
  "name": "Magnet to qBittorrent",
  "description": "Intercepts magnet links and sends them to your qBittorrent Web UI, with category, tags, and paused state.",
  "version": "0.4.0",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "contextMenus",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": ["src/background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    "src/tokens.css",
    "icons/icon.svg"
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "Magnet to qBittorrent",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "magnet-to-qbittorrent@local"
    }
  }
}
